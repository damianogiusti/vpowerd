# Copy to /etc/vpowerd.env and edit.
VPOWERD_DEVICE=auto
# auto, hidraw or serial. auto detects hidraw nodes even under another name,
# e.g. /dev/ups in a Proxmox LXC.
#VPOWERD_TRANSPORT=auto
VPOWERD_LISTEN=:8080
VPOWERD_POLL_INTERVAL=10s
VPOWERD_DEVICE_ID=ups
#VPOWERD_MQTT_URL=tcp://192.168.1.10:1883
#VPOWERD_MQTT_USER=vpowerd
#VPOWERD_MQTT_PASSWORD=change-me
VPOWERD_ALLOW_CONTROL=false
#VPOWERD_API_TOKEN=change-me
#VPOWERD_LOG_LEVEL=debug
